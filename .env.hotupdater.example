# Hot Updater Supabase Configuration
# Copy this to .env.hotupdater and fill in your Supabase credentials

# Get these from your Supabase project settings -> API
HOT_UPDATER_SUPABASE_URL=https://your-project.supabase.co
HOT_UPDATER_SUPABASE_ANON_KEY=your-anon-key-here

# Storage bucket name (will be created in Supabase Storage)
HOT_UPDATER_SUPABASE_BUCKET_NAME=hot-updater
